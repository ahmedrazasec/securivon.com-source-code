# Securivon — environment variable template.
#
# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored and must never be committed.
# This file (.env.example) contains placeholders only — no real
# credentials, secrets, or connection strings belong here.
#
# See README.md "Environment variables" for the authoritative
# description of each variable.

# --- Currently read by application code -------------------------------

# PostgreSQL connection string. Required by Prisma (CLI, via
# prisma.config.ts) and by the Prisma driver adapter at runtime
# (src/server/db/client.ts).
DATABASE_URL=

# Secret used to sign Admin session JWTs (jose, HS256). Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Interim bootstrap Admin login, used until the Prisma-backed
# AdminUserRepository is activated. ADMIN_BOOTSTRAP_PASSWORD_HASH must be
# a bcrypt hash, never a plain-text password.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD_HASH=

# --- Documented but not yet wired into application code ---------------
# (see README "Environment variables" — listed here for forward
# compatibility; safe to leave blank until the corresponding feature
# is implemented)

# wa.me link generation. Config value, not a secret.
WHATSAPP_BUSINESS_NUMBER=

# Error tracking. Vendor not yet decided.
ERROR_MONITORING_DSN=

# Analytics. Tool not yet decided.
ANALYTICS_ID=

# Public form spam/bot protection. Not wired in yet at foundation stage.
SPAM_PROTECTION_KEY=

# Product photography / image storage. Exact variable name(s) not yet
# finalized — needed once real, verified product images exist.
# IMAGE_STORAGE_*=
